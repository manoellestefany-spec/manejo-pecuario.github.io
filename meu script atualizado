-- =========================================================================
-- 10. CONSULTAS DEMONSTRATIVAS DAS FORMAS NORMAIS (DQL)
-- =========================================================================

-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO 1: RECONSTRUÇÃO DA 3FN (JOIN entre Pasto, Lote e Animal)
-- Como não duplicamos os dados do Pasto nem do Lote na tabela Animal,
-- usamos JOIN para trazer o relatório completo!
-- -------------------------------------------------------------------------
SELECT 
    a.brincoIdentificacao AS 'Brinco',
    a.raca AS 'Raça',
    l.nomeLote AS 'Lote Pertencente',
    p.nomePasto AS 'Pasto Alocado',
    p.tipoCapim AS 'Capim do Pasto'
FROM Animal a
INNER JOIN Lote l ON a.idLote = l.idLote
INNER JOIN Pasto p ON l.idPasto = p.idPasto
WHERE a.statusAnimal = 'Ativo'
ORDER BY a.brincoIdentificacao;


-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO 2: CONSULTA 1FN (Histórico de Pesagens por Animal)
-- Exibe a evolução do peso sem misturar múltiplos valores na tabela Animal.
-- -------------------------------------------------------------------------
SELECT 
    a.brincoIdentificacao AS 'Brinco',
    pes.dataPesagem AS 'Data da Pesagem',
    pes.pesoKg AS 'Peso (Kg)'
FROM Animal a
INNER JOIN Pesagem pes ON a.idAnimal = pes.idAnimal
WHERE a.idAnimal = 1
ORDER BY pes.dataPesagem ASC;


-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO 3: RECONSTRUÇÃO DA 2FN (Aplicações de Vacina)
-- Cruza a tabela associativa AplicacaoVacina trazendo os dados do boi e da vacina.
-- -------------------------------------------------------------------------
SELECT 
    a.brincoIdentificacao AS 'Brinco do Animal',
    v.nomeVacina AS 'Vacina Aplicada',
    v.fabricante AS 'Fabricante',
    ap.doseMl AS 'Dose (ml)',
    ap.dataAplicacao AS 'Data de Aplicação'
FROM AplicacaoVacina ap
INNER JOIN Animal a ON ap.idAnimal = a.idAnimal
INNER JOIN Vacina v ON ap.idVacina = v.idVacina
ORDER BY ap.dataAplicacao DESC;


-- -------------------------------------------------------------------------
-- DEMONSTRAÇÃO 4: LEFT JOIN E AGREGAÇÃO (Contagem por Lote incluindo Vazio)
-- Mostra a contagem de animais por lote, identificando inclusive o lote sem animais.
-- -------------------------------------------------------------------------
SELECT 
    l.nomeLote AS 'Nome do Lote',
    COUNT(a.idAnimal) AS 'Total de Animais'
FROM Lote l
LEFT JOIN Animal a ON l.idLote = a.idLote
GROUP BY l.idLote, l.nomeLote
ORDER BY `Total de Animais` DESC;
