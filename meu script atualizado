
-- =========================================================================
-- PROJETO PRÁTICO: SISTEMA DE MANEJO PECUÁRIO
-- Aplicação das Formas Normais (1FN, 2FN e 3FN) e Mapeamento DER -> SQL
-- Contexto: Gestão de Pastos, Lotes, Animais, Pesagens, Vacinas e Vendas
-- =========================================================================

-- Limpa a base de dados caso ela já exista para evitar erros ao recriar
DROP DATABASE IF EXISTS ManejoPecuarioDB;

-- Criação e seleção do banco de dados oficial do sistema
CREATE DATABASE ManejoPecuarioDB;
USE ManejoPecuarioDB;


-- =========================================================================
-- CONCEITO CENTRAL DE NORMALIZAÇÃO
-- "Garantir a integridade dos dados sem redundâncias ou inconsistências!"
-- =========================================================================


-- =========================================================================
-- 1. TABELA PASTO (Entidade Pai do Lote - Relacionamento 1:N)
-- =========================================================================
CREATE TABLE Pasto (
  -- idPasto: Chave Primária Única do Pasto
  idPasto INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,

  -- Atributos simples para descrever o local físico da propriedade
  nomePasto VARCHAR(100) NOT NULL,
  areaHectares DECIMAL(10,2) NOT NULL,
  tipoCapim VARCHAR(50) NOT NULL
);


-- =========================================================================
-- 2. TABELA LOTE (Aplicando 3FN - Dependência Transitiva)
--
-- APLICAÇÃO DA 3ª FORMA NORMAL (3FN):
-- 1. O Lote está vinculado a um Pasto através da Chave Estrangeira 'idPasto'.
-- 2. Não colocamos dados do Pasto (como tipoCapim ou areaHectares) aqui dentro!
--    Isso evita repetir informações do pasto a cada novo lote cadastrado.
-- =========================================================================
CREATE TABLE Lote (
  idLote INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  nomeLote VARCHAR(100) NOT NULL,
  capacidadeMaxima INT UNSIGNED NOT NULL,

  -- Chave Estrangeira apontando para o Pasto onde o lote está alocado
  idPasto INT UNSIGNED NOT NULL,

  CONSTRAINT fk_lote_pasto
    FOREIGN KEY (idPasto)
    REFERENCES Pasto(idPasto)
    ON DELETE RESTRICT
);


-- =========================================================================
-- 3. TABELA VENDA (Tabela Independente de Transações Comerciais)
-- =========================================================================
CREATE TABLE Venda (
  idVenda INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  dataVenda DATE NOT NULL,
  comprador VARCHAR(150) NOT NULL,
  valorTotalTransacao DECIMAL(12,2) NOT NULL
);


-- =========================================================================
-- 4. TABELA ANIMAL (Aplicando 1FN e 3FN)
--
-- APLICAÇÃO DA 1ª FORMA NORMAL (1FN - ATOMICIDADE):
-- 1. O brinco de identificação é único por cabeça de gado.
-- 2. Históricos como 'Pesagens' e 'Aplicações de Vacina' foram REMOVIDOS desta 
--    tabela (pois o animal pesa várias vezes e toma várias vacinas ao longo do tempo).
--    Se ficassem aqui, violariam a 1FN criando campos repetidos ou listas na mesma célula.
--
-- APLICAÇÃO DA 3ª FORMA NORMAL (3FN):
-- 1. O animal guarda apenas 'idLote' e 'idVenda' (que pode ser NULO enquanto não vendido).
-- 2. O nome do lote e os dados do comprador NÃO ficam nesta tabela.
-- =========================================================================
CREATE TABLE Animal (
  idAnimal INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  brincoIdentificacao VARCHAR(50) NOT NULL UNIQUE,
  dataNascimento DATE NOT NULL,
  sexo CHAR(1) NOT NULL,
  raca VARCHAR(50) NOT NULL,
  statusAnimal VARCHAR(20) NOT NULL DEFAULT 'Ativo', -- Ex: Ativo, Vendido, Morto

  -- Relacionamento 1:N com Lote (Obrigatório)
  idLote INT UNSIGNED NOT NULL,

  -- Relacionamento 1:N com Venda (Opcional - nulo enquanto for do rebanho)
  idVenda INT UNSIGNED NULL,

  CONSTRAINT fk_animal_lote
    FOREIGN KEY (idLote)
    REFERENCES Lote(idLote),

  CONSTRAINT fk_animal_venda
    FOREIGN KEY (idVenda)
    REFERENCES Venda(idVenda)
);


-- =========================================================================
-- 5. TABELA PESAGEM (Solução da 1FN para Histórico do Animal)
--
-- CONCEITO:
-- Um mesmo animal acumula várias pesagens na sua engorda. Para não violar a 1FN,
-- isolamos o peso e a data nesta tabela ligada ao idAnimal via FK.
-- =========================================================================
CREATE TABLE Pesagem (
  idPesagem INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  dataPesagem DATE NOT NULL,
  pesoKg DECIMAL(6,2) NOT NULL,
  
  -- FK identificando a qual animal pertence esta medição
  idAnimal INT UNSIGNED NOT NULL,

  CONSTRAINT fk_pesagem_animal
    FOREIGN KEY (idAnimal)
    REFERENCES Animal(idAnimal)
    ON DELETE CASCADE
);


-- =========================================================================
-- 6. TABELA VACINA (Catálogo de Medicamentos da Fazenda)
-- =========================================================================
CREATE TABLE Vacina (
  idVacina INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  nomeVacina VARCHAR(100) NOT NULL,
  fabricante VARCHAR(100) NOT NULL,
  periodoValidadeDias INT UNSIGNED NOT NULL
);


-- =========================================================================
-- 7. TABELA APLICACAO_VACINA (Aplicando a 2ª FORMA NORMAL - 2FN)
--
-- CONCEITO: Relacionamento N:N (Muitos para Muitos) entre Animal e Vacina.
-- Um animal toma várias vacinas e uma vacina é usada em vários animais.
--
-- APLICAÇÃO DA 2ª FORMA NORMAL (2FN - DEPENDÊNCIA FUNCIONAL TOTAL):
-- Regra: A aplicação precisa ter os atributos que dependem desse evento específico!
--
-- FORMA CORRETA (2FN APLICADA):
-- 1. 'dataAplicacao' e 'doseMl' pertencem exclusivamente ao momento da aplicação.
-- 2. O nome da vacina fica isolado na tabela Vacina, e os dados do boi ficam na tabela Animal.
-- =========================================================================
CREATE TABLE AplicacaoVacina (
  idAplicacao INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  dataAplicacao DATE NOT NULL,
  doseMl DECIMAL(5,2) NOT NULL,

  -- Chaves Estrangeiras do evento de imunização
  idAnimal INT UNSIGNED NOT NULL,
  idVacina INT UNSIGNED NOT NULL,

  CONSTRAINT fk_aplicacao_animal
    FOREIGN KEY (idAnimal)
    REFERENCES Animal(idAnimal)
    ON DELETE CASCADE,

  CONSTRAINT fk_aplicacao_vacina
    FOREIGN KEY (idVacina)
    REFERENCES Vacina(idVacina)
);


-- =========================================================================
-- 8. TABELA OBITO (Relacionamento 1:1 - Registros Especiais)
--
-- CONCEITO:
-- Nem todo animal morre na fazenda (muitos são vendidos). 
-- Um animal pode registrar no máximo 1 óbito. Para isso usamos UNIQUE na FK!
-- =========================================================================
CREATE TABLE Obito (
  idObito INT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
  dataObito DATE NOT NULL,
  motivo VARCHAR(255) NOT NULL,

  -- UNIQUE garante a restrição de que 1 animal só tem 1 óbito registrado (1:1)
  idAnimal INT UNSIGNED NOT NULL UNIQUE,

  CONSTRAINT fk_obito_animal
    FOREIGN KEY (idAnimal)
    REFERENCES Animal(idAnimal)
    ON DELETE CASCADE
);


